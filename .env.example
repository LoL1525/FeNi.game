# Set this to the public HTTPS URL where the built game is hosted.
# Planet NFT metadata and artwork are generated with this URL and must be publicly reachable.
VITE_PUBLIC_URL=https://your-public-game-domain.example

# Configure these as runtime environment variables for the Node game server.
# Do not add them to VITE_* variables: those are bundled into public browser code.
# GAME_AUTH_SECRET=generate-a-unique-random-secret-at-least-32-characters-long
# GAME_SITE_ORIGIN=https://your-public-game-domain.example
# GAME_DATA_DIR=/path/to/a-persistent-volume
# GAME_BACKUP_DIR=/path/to/a-separate-persistent-backup-volume
# GAME_SOLANA_RPC_URL=https://api.devnet.solana.com
